# ─────────────────────────────────────────────────────────────
# CGCI Student Login — Firebase web app configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values shown
# in the Firebase Console → Project settings → Your apps → SDK setup.
#
# SECURITY NOTE
# Firebase *web* configuration is public by design: this object is
# bundled into the JavaScript shipped to every visitor and cannot be
# kept secret. Access is not protected by hiding these values — it is
# protected by Firestore Security Rules, Firebase Authentication,
# and the authorised-domain allowlist in the Firebase Console.
# Never place service-account keys or admin credentials in this file.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase Analytics measurement ID (omit to disable analytics)
VITE_FIREBASE_MEASUREMENT_ID=