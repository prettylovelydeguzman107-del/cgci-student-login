# ── Dependencies ────────────────────────────────────────────────────────────
node_modules

# ── Build output ─────────────────────────────────────────────────────────────
dist
dist-ssr
*.local

# ── Environment ──────────────────────────────────────────────────────────────
# Firebase web configuration is public by design and belongs in .env.local,
# which is generated per machine. Only .env.example is committed.
.env
.env.local
.env.*.local
!.env.example

# Never commit credentials of any kind.
serviceAccountKey*.json
*-service-account*.json
firebase-adminsdk-*.json
*.pem
*.key

# ── Logs ─────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Firebase emulators ───────────────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# ── Test output ──────────────────────────────────────────────────────────────
coverage/

# ── Editor and OS ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
